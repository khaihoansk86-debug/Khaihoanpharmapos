.env
.env.local
.env.*.local
js/core/config.local.js

# --- Hệ điều hành ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Editor / IDE ---
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Node (nếu sau này thêm build tool) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# --- Logs ---
*.log
.ast-graph/

# --- Hồ sơ trình duyệt/Zalo cục bộ (chứa cookie và phiên đăng nhập) ---
bot-assistant/zalo-session/
zalo-session/
zalo-chrome-profile/

# --- Dữ liệu chạy tạm của bot ---
bot-assistant/data/

.vercel
.env*
